{
  "version": 1,
  "contentSearch": "deny",
  "roles": {
    "review": {
      "allowedTools": [
        "read",
        "find",
        "list",
        "glob"
      ],
      "deniedTools": [
        "edit",
        "write",
        "bash",
        "webfetch",
        "websearch",
        "execute",
        "skill",
        "task"
      ],
      "read": {
        "denyPaths": [
          ".env",
          ".env.*",
          ".git",
          ".git/**",
          "/proc/*",
          "/proc/**"
        ],
        "allowPaths": [
          ".env.example"
        ]
      },
      "edit": {
        "denyPaths": [
          "*"
        ],
        "allowPaths": []
      }
    },
    "analyse": {
      "allowedTools": [
        "read",
        "find",
        "list",
        "glob",
        "edit"
      ],
      "deniedTools": [
        "bash",
        "webfetch",
        "websearch",
        "execute",
        "skill",
        "task"
      ],
      "read": {
        "denyPaths": [
          ".env",
          ".env.*",
          ".git",
          ".git/**",
          "/proc/*",
          "/proc/**"
        ],
        "allowPaths": [
          ".env.example"
        ]
      },
      "edit": {
        "denyPaths": [
          ".smooth-ai-review-tools/**",
          ".context/**",
          "ci_temp/**",
          ".git",
          ".git/**",
          ".env",
          ".env.*"
        ],
        "allowPaths": [
          ".env.example"
        ]
      }
    }
  }
}
